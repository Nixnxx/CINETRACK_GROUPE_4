				{
					"_type": "UMLCollaboration",
					"_id": "COLLAB-001",
					"name": "Collaboration_AjouterFilm",
					"ownedElements": [
						{
							"_type": "UMLInteraction",
							"_id": "INTERACTION-001",
							"name": "AjouterFilm",
							"messages": [
								{
									"_type": "UMLMessage",
									"_id": "MSG-01",
									"name": "clic \"Ajouter\""
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-02",
									"name": "ouvre DialogueFilm (JDialog modal)"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-03",
									"name": "saisit titre, genre, durée, note, synopsis"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-04",
									"name": "clic \"Valider\""
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-05",
									"name": "ajouterFilm(titre, genre, duree, note, synopsis)"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-06",
									"name": "valide saisie (parseInt / parseDouble)"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-07",
									"name": "dao.insert(film)"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-08",
									"name": "INSERT INTO films VALUES (...)"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-09",
									"name": "rowsAffected = 1",
									"messageSort": "reply"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-10",
									"name": "return true",
									"messageSort": "reply"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-11",
									"name": "throw NoteInvalideException / NumberFormatException"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-12",
									"name": "vue.afficherErreur(e.getMessage())"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-13",
									"name": "afficherSucces(\"Film ajouté avec succès\")",
									"messageSort": "reply"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-14",
									"name": "chargerFilms()"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-15",
									"name": "dao.findAll()"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-16",
									"name": "SELECT * FROM films ORDER BY titre"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-17",
									"name": "List<Film>",
									"messageSort": "reply"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-18",
									"name": "vue.afficherFilms(liste)",
									"messageSort": "reply"
								},
								{
									"_type": "UMLMessage",
									"_id": "MSG-19",
									"name": "JTable mis à jour",
									"messageSort": "reply"
								}
