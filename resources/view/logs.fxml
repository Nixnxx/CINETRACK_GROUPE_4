<?xml version="1.0" encoding="UTF-8"?>

<!--
====================================================================
COUCHE : VIEW (écran Logs décrit en FXML, réservé à l'admin)
====================================================================
Aucune logique métier, aucun SQL : tout est délégué au contrôleur
fx:controller="controleur.LogControleur".
-->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controleur.LogControleur">

    <!-- Bandeau du haut : titre avec le nombre de logs, filtres -->
    <top>
        <HBox alignment="CENTER" styleClass="bandeau">
            <Label fx:id="labelNbLogs" styleClass="titre-section" text="Logs d'activité" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                <Label styleClass="libelle" text="Table :" />
                <TextField fx:id="champFiltreTable" onAction="#onFiltrer" prefColumnCount="8" />
                <Label styleClass="libelle" text="Action :" />
                <ComboBox fx:id="comboFiltreAction" />
                <Button onAction="#onToutAfficher" styleClass="bouton-gris" text="Tout afficher" />
            </HBox>
        </HBox>
    </top>

    <!-- Centre : tableau des logs -->
    <center>
        <TableView fx:id="tableLogs">
            <placeholder>
                <Label text="Aucun log" />
            </placeholder>
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colTable" prefWidth="90.0" text="Table" />
                <TableColumn fx:id="colAction" prefWidth="100.0" text="Action" />
                <TableColumn fx:id="colIdCible" prefWidth="80.0" text="ID cible" />
                <TableColumn fx:id="colDetail" prefWidth="380.0" text="Détail" />
                <TableColumn fx:id="colPar" prefWidth="120.0" text="Effectué par" />
                <TableColumn fx:id="colDate" prefWidth="160.0" text="Date" />
            </columns>
        </TableView>
    </center>

    <!-- Bas : rafraîchir et légende des couleurs -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="barre-boutons">
            <Button onAction="#onFiltrer" styleClass="bouton-gris" text="↺ Rafraîchir" />
            <Region prefWidth="20.0" />
            <Label styleClass="badge-log, badge-insert" text="INSERT" />
            <Label styleClass="badge-log, badge-update" text="UPDATE" />
            <Label styleClass="badge-log, badge-delete" text="DELETE" />
            <Label styleClass="badge-log, badge-connexion" text="CONNEXION" />
        </HBox>
    </bottom>

</BorderPane>
